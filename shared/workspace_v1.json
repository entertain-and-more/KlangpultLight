{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "klangpultlight-workspace-v1",
  "title": "Klangpult light Workspace Payload v1",
  "description": "Plan-Payload: der Klangpult light – Planer plant Board/Line/Teleprompter, der Klangpult light – Recorder führt es aus.",
  "type": "object",
  "required": ["format", "version"],
  "properties": {
    "format": { "const": "klangpultlight-workspace-v1" },
    "version": { "type": "integer", "minimum": 1 },
    "board": {
      "type": "object",
      "description": "Gemeinsames Audio-Videoboard: ein Board mit gemischten Pad-Typen.",
      "properties": {
        "pads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "color": { "type": "string" },
              "kind": { "type": "string", "enum": ["audio", "video", "image"] },
              "asset_path": { "type": "string" },
              "mode": { "type": "string", "enum": ["play_stop", "loop", "overlap"] },
              "hotkey": { "type": "string" }
            }
          }
        }
      }
    },
    "line": {
      "type": "array",
      "description": "Geplante Einspieler-Reihenfolge (verweist auf Pad-IDs).",
      "items": { "type": "string" }
    },
    "teleprompter": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "font_size": { "type": "integer", "minimum": 8 },
        "scroll_speed": { "type": "number", "minimum": 0 }
      }
    }
  }
}
